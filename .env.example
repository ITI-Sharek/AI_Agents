LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=45

# Alibaba Model Studio (Qwen Models) - 1M Free Tokens
AI_PROVIDER=alibaba
ALIBABA_API_KEY=your-dashscope-api-key-here
ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
ALIBABA_MODEL=qwen2.5-coder-32b-instruct
ALIBABA_ENABLE_THINKING=false

# Document Understanding Agent (RAG)
DOC_UNDERSTANDING_LLM_PROVIDER=alibaba
DOC_UNDERSTANDING_LLM_MODEL=qwen-plus
DOC_UNDERSTANDING_LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DOC_UNDERSTANDING_LLM_API_KEY=your-dashscope-api-key-here

# Security & Shared Tokens
AI_SERVICE_AUTH_TOKEN=replace-with-the-same-random-token-used-by-the-backend
AI_SKILL_PROFILE_TIMEOUT_SECONDS=60
AI_SERVICE_VERSION=0.1.0

# Optional Fallbacks (Groq / OpenRouter)
GROQ_API_KEY=replace-with-a-new-groq-key
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
