AI_SERVICE_AUTH_TOKEN=replace-with-the-same-long-random-token-used-by-nestjs
LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-a-provider-key
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=45
AI_ADVISORY_FIT_TIMEOUT_SECONDS=60
AI_ADVISORY_FIT_MAX_RETRIES=1
AI_SERVICE_VERSION=0.1.0
AI_SKILL_PROFILE_TIMEOUT_SECONDS=60

# Requirement inference (P0-A01). Reads the Contribution Request only.
AI_REQUIREMENT_INFERENCE_TIMEOUT_SECONDS=60
AI_REQUIREMENT_INFERENCE_MAX_RETRIES=1

# Skill-gap guidance and material analysis. Both reached the provider stage in
# verification with these unset, which fails closed as 502 rather than serving
# an unsourced answer.
AI_SKILL_GAP_GUIDANCE_TIMEOUT_SECONDS=60
AI_SKILL_GAP_GUIDANCE_MAX_RETRIES=1
MATERIAL_ANALYSIS_TIMEOUT_SECONDS=120
DOC_UNDERSTANDING_TIMEOUT_SECONDS=120

# Provider used by material analysis and skill-gap guidance (common/llm.py).
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-with-a-provider-key
DEFAULT_MODEL=openrouter/free

# Semantic matching is present but NOT registered as a route — its I/O contract
# is being reworked under AI #11. Unset until then.
SEMANTIC_MATCHING_DATABASE_URL=

# Match ranking (P1-A01). Reorders a backend-computed shortlist and explains
# each match; never discovers candidates and never returns a score.
AI_MATCHING_RANK_TIMEOUT_SECONDS=30
AI_MATCHING_RANK_MAX_RETRIES=1

# Gold owner contributor matching. NestJS supplies the authorized candidate
# set; this service only ranks and explains it.
AI_CONTRIBUTOR_MATCHING_TIMEOUT_SECONDS=75
AI_CONTRIBUTOR_MATCHING_MAX_RETRIES=1
