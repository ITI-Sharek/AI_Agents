LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=45
GROQ_API_KEY=replace-with-a-new-groq-key
AI_SERVICE_AUTH_TOKEN=replace-with-the-same-random-token-used-by-the-backend
ANALYSIS_SERVICE_URL=http://127.0.0.1:8000
ANALYSIS_SERVICE_AUTH_TOKEN=replace-with-the-same-random-token-used-by-the-backend
AI_SKILL_PROFILE_TIMEOUT_SECONDS=180

# Skill-profile/advisory model provider. OpenRouter is the default.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=openrouter/free

# Used only when AI_PROVIDER=student-api-gateway.
GETAWAY_ITI_KEY=replace-with-your-student-gateway-key
GETAWAY_BASE_URL=http://apiaccess.iti.net.eg
GETAWAY_MODEL=antropic.claude-sonnet-4.6
AI_ADVISORY_FIT_MAX_RETRIES=1
MATERIAL_ANALYSIS_TIMEOUT_SECONDS=120
