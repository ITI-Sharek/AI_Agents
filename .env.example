AI_PROVIDER=alibaba
ALIBABA_API_KEY=replace-with-your-singapore-model-studio-key
ALIBABA_BASE_URL=https://replace-with-workspace-id.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
ALIBABA_MODEL=qwen3.7-plus
AI_SKILL_PROFILE_TIMEOUT_SECONDS=60
AI_SERVICE_AUTH_TOKEN=replace-with-the-same-random-token-used-by-the-backend

# Existing provider fallback. Keep these available when AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Legacy Groq environments remain selectable with AI_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
