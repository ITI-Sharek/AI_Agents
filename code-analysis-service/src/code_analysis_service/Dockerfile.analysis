# Runner image for the code-analysis-service sandbox.
#
# Build context must be the repository root:
#   docker build -t code-analysis-runner:latest -f code-analysis-service/src/code_analysis_service/Dockerfile.analysis .
#
# The image bundles the service itself so the orchestrator can execute
# analysis INSIDE the container (python -m code_analysis_service.sandbox_runner).
# Any analysis tool missing from this image is reported as tool_unavailable
# by the sandbox runner — the service never falls back to host execution.
#
# Security properties of the container started from this image
# (see container_sandbox.py):
#   * read-only root filesystem with exec-able tmpfs /tmp, /root and /workspace
#   * no network capabilities (--cap-drop ALL) and no new privileges
#   * the container is disconnected from its network before analysis runs
#   * all processes run as the non-root `analysis` user (uid 1000)
#   * HOME is set to the writable tmpfs /tmp at container start
#
# Every downloaded tool is pinned to an exact version and fetched over HTTPS
# with sha256 verification (no curl | sh / curl | bash installers).

FROM python:3.11.9-slim

ENV DEBIAN_FRONTEND=noninteractive \
    GOTOOLCHAIN=local \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    DOTNET_ROOT=/opt/dotnet \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    PATH="/usr/local/go/bin:/go/bin:/usr/local/cargo/bin:/opt/dotnet:/var/lib/gems/3.1.0/bin:${PATH}"

# Base tools plus the Debian-packaged language runtimes. gcc/g++/make and
# ruby-dev are required to build the Ruby prism gem used by RuboCop 1.65.1;
# php8.2-xml/php8.2-mbstring are runtime requirements of PHP_CodeSniffer 3.x;
# xz-utils is required by rustup to unpack the toolchain archives.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    curl \
    xz-utils \
    gcc \
    g++ \
    make \
    ruby \
    ruby-dev \
    php8.2-cli \
    php8.2-xml \
    php8.2-mbstring \
    openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*

# Go toolchain (newer than Debian's, required by the Go analyzers),
# gocyclo and golangci-lint. All three are pinned and sha256-verified.
RUN curl -fsSL https://go.dev/dl/go1.22.5.linux-amd64.tar.gz -o /tmp/go.tgz \
    && echo "904b924d435eaea086515bc63235b192ea441bd8c9b198c507e85009e6e4c7f0  /tmp/go.tgz" | sha256sum -c - \
    && rm -rf /usr/local/go \
    && tar -C /usr/local -xzf /tmp/go.tgz \
    && rm /tmp/go.tgz \
    && mkdir -p /go/bin \
    && GOPATH=/go GOBIN=/go/bin go install github.com/fzipp/gocyclo/cmd/gocyclo@v0.6.0 \
    && curl -fsSL https://github.com/golangci/golangci-lint/releases/download/v1.59.1/golangci-lint-1.59.1-linux-amd64.tar.gz -o /tmp/golangci-lint.tgz \
    && echo "c30696f1292cff8778a495400745f0f9c0406a3f38d8bb12cef48d599f6c7791  /tmp/golangci-lint.tgz" | sha256sum -c - \
    && tar -C /usr/local/bin --strip-components=1 -xzf /tmp/golangci-lint.tgz golangci-lint-1.59.1-linux-amd64/golangci-lint \
    && rm /tmp/golangci-lint.tgz \
    && rm -rf /go/pkg /go/src /go/cache /root/.cache

# Rust toolchain 1.86.0 and Clippy via rustup (pinned installer, sha256-
# verified). clippy-driver is what the Rust analyzer invokes.
RUN curl -fsSL https://static.rust-lang.org/rustup/dist/x86_64-unknown-linux-gnu/rustup-init -o /tmp/rustup-init \
    && echo "4acc9acc76d5079515b46346a485974457b5a79893cfb01112423c89aeb5aa10  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --profile minimal --default-toolchain 1.86.0 --no-modify-path \
    && rm /tmp/rustup-init \
    && rustup set auto-self-update disable \
    && rustup component add clippy

# Python analyzers and Graphify. The PyPI package `graphifyy` provides the
# `graphify` CLI; `graphify extract --code-only --no-cluster` is a fully
# local, offline extraction (no API key, no network) — the container is
# network-isolated while analysis runs.
RUN pip install --no-cache-dir \
    radon==6.0.1 \
    pylint==3.3.1 \
    graphifyy==0.9.28

# Node.js, npm, ESLint and the TypeScript parser so .ts/.tsx files can be
# analyzed. Parser resolution at runtime uses NODE_PATH (set by
# container_sandbox.py) so ESLint finds the globally installed
# @typescript-eslint/parser even with --no-eslintrc.
COPY --from=node:20.15.0-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=node:20.15.0-slim /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && npm install -g \
        eslint@8.57.1 \
        @typescript-eslint/parser@8.6.0 \
        typescript@5.6.2 \
    && npm cache clean --force

# Ruby analyzer (RuboCop). Pinned at 1.65.1: it predates the
# `--force-default-config` regression present in rubocop >= 1.82.0.
RUN gem install rubocop -v 1.65.1 --no-document

# PHP analyzer (PHP_CodeSniffer 3.11.3 from PHPCSStandards — the
# squizlabs/PHP_CodeSniffer release line ended at 3.10.3, which is why
# the previous 3.10.3 URL returned 404).
RUN curl -fsSL https://github.com/PHPCSStandards/PHP_CodeSniffer/releases/download/3.11.3/phpcs.phar \
        -o /usr/local/bin/phpcs \
    && echo "f043b299b6f3aa1a8b78cb47848cee28cdc524f31ceff6b24ff70eaf8bf39936  /usr/local/bin/phpcs" | sha256sum -c - \
    && chmod +x /usr/local/bin/phpcs

# Java analyzer (Checkstyle) plus the /sun_checks.xml config the Java
# adapter passes with -c. The config is the canonical sun_checks.xml from
# the checkstyle-10.21.2 source tree (bundled in this repository so the
# image no longer fetches it from a moving GitHub raw URL).
COPY code-analysis-service/src/code_analysis_service/sun_checks.xml /sun_checks.xml
RUN curl -fsSL https://github.com/checkstyle/checkstyle/releases/download/checkstyle-10.21.2/checkstyle-10.21.2-all.jar \
        -o /opt/checkstyle.jar \
    && echo "afcba25e869016442972ec4513a8c06c812edf68f511c88ef497de00c3383917  /opt/checkstyle.jar" | sha256sum -c - \
    && printf '#!/bin/sh\nexec java -jar /opt/checkstyle.jar "$@"\n' > /usr/local/bin/checkstyle \
    && chmod +x /usr/local/bin/checkstyle

# C# SDK (8.0.423, 8.0 LTS) — used by dotnet build for the C# static
# adapter. Pinned tarball with sha256 verification (replaces the
# curl | bash dotnet-install.sh path).
RUN curl -fsSL https://dotnetcli.azureedge.net/dotnet/Sdk/8.0.423/dotnet-sdk-8.0.423-linux-x64.tar.gz -o /tmp/dotnet-sdk.tgz \
    && echo "05e69a3c48f6ce37bdf18e9db527d26fc7fc46d4d99fa143660fe09bf23acd4d  /tmp/dotnet-sdk.tgz" | sha256sum -c - \
    && mkdir -p /opt/dotnet \
    && tar -C /opt/dotnet -xzf /tmp/dotnet-sdk.tgz \
    && rm /tmp/dotnet-sdk.tgz

# The service itself, so `python -m code_analysis_service.sandbox_runner`
# works inside the container.
COPY code-analysis-service /service-src
RUN pip install --no-cache-dir /service-src

# All analysis processes run as this non-root user. The orchestrator
# starts containers with tmpfs /tmp, /root and /workspace (world-writable)
# and sets HOME=/tmp (see container_sandbox.py).
RUN useradd --create-home --uid 1000 analysis

USER analysis

WORKDIR /workspace
ENTRYPOINT ["/bin/sh", "-c"]
